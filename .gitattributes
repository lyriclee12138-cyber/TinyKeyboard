# 统一行尾，避免 Windows/Linux 交叉编辑产生 CRLF 污染
# text=auto 让 Git 自动判定文本/二进制，文本以 LF 入库、检出时按平台转换
* text=auto

# 二进制文件不做任何行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bin binary
*.elf binary

# 源码统一 LF 入库（嵌入式/脚本/网页对行尾敏感）
*.c      text eol=lf
*.h      text eol=lf
*.ino    text eol=lf
*.py     text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.cmake  text eol=lf
*.csv    text eol=lf

# Windows 批处理 / PowerShell 脚本保留 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
