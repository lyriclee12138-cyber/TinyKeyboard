# 目标板：ESP32-S3 DevKitC-1 (N16R8, 16MB Flash + 8MB PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# Flash 16MB / QIO 80MHz
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 控制台只走 UART0（GPIO43/44 -> 板载 COM 口）
# 关键：关掉 USB-Serial-JTAG 二级控制台，否则会和 TinyUSB 抢 USB PHY
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 自定义分区表（应用区 2MB，给 WiFi + httpd 留余量）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 本工程不需要 PSRAM
# CONFIG_SPIRAM is not set

# 主频拉满，打字更顺
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# tick 提到 1000Hz：默认是 100Hz(10ms)，会把 3ms/8ms 的按键延时全部量化成 10ms
CONFIG_FREERTOS_HZ=1000

# 使能 TinyUSB 的 HID 类（默认是 0，不开会导致 tud_hid_* 链接失败）
CONFIG_TINYUSB_HID_COUNT=2

# 日志级别（正式用可以调成 WARN 减少串口输出）
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
